{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC 2022 Release",
      "description": "Build with MSVC 2022 and Qt 6.5.3 in Release mode",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.5.3/msvc2019_64"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC 2022 Debug",
      "description": "Build with MSVC 2022 and Qt 6.5.3 in Debug mode",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.5.3/msvc2019_64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "windows-msvc-release"
    },
    {
      "name": "debug",
      "configurePreset": "windows-msvc-debug"
    }
  ]
}
